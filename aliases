#!/bin/bash -e
#
# Load the scripts into the current shell so they can be run by name.

PROJECT_ROOT=$(realpath "$(dirname "${BASH_SOURCE[0]}")")

for script in bootstrap check clean init lint setup test uninstall; do
    eval "function ${script}() { \"${PROJECT_ROOT}/scripts/${script}\" \"\$@\"; }"
done

echo 'Script commands are ready to use in current shell environment.'
